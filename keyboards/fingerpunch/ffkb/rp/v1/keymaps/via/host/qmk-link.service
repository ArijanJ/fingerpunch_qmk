[Unit]
Description=QMK keyboard desktop notifications
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/share/qmk-link/.venv/bin/python %h/.local/share/qmk-link/qmk_link.py --notify
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
